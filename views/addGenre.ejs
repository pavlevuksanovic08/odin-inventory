<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1><%= locals.genre ? 'Edit genre' : 'Add Genre'%></h1>
    <form method="post" action="<%= locals.genre ? `/genres/${genre.genreid}/edit` : '/genres/add'%>">
        <input type="text" name="name" value="<%= locals.genre ? genre.name : ''%>">
        <button type="submit"><%= locals.genre ? 'Edit' : 'Add' %></button>
    </form>
    <% if (locals.errors) { %>
        <% locals.errors.forEach(err => { %>
            <p><%= err.msg %></p>
        <%})%>
    <%}%>
</body>
</html>