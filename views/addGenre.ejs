<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Add Genre</h1>
    <form method="post" action="/genres/add">
        <input type="text" name="name">
        <button type="submit">Add</button>
    </form>
    <% if (locals.errors) { %>
        <% locals.errors.forEach(err => { %>
            <p><%= err.msg %></p>
        <%})%>
    <%}%>
</body>
</html>