<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1><%= locals.movie ? 'Edit movie' : 'Add movie' %></h1>
    <form method="post" action="<%= locals.movie ? `/movies/${movie.movieid}/edit` : '/movies/add' %>">
        <label>Title:</label>
        <input type="text" name="title" value="<%= locals.movie ? movie.title : '' %>">
        <label>Genre:</label>
        <% genres.forEach(g => { %>
            <label>
                <input type="checkbox" name="genres" value="<%= g.genreid %>" <%= locals.movie ? movie.genre.includes(g.name) ? 'checked' : '' : '' %>> <%= g.name %>
            </label>
        <%})%>
        <label>Director:</label>
        <input type="text" name="director" value="<%= locals.movie ? movie.director : ''%>">
        <button type="submit"><%= locals.movie ? 'Edit' : 'Add' %></button>
    </form>
    <% if (locals.errors) { %>
        <% locals.errors.forEach(e => { %>
            <p><%= e.msg %></p>
        <%})%>
    <%}%>
</body>
</html>