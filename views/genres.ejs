<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>
        Genres
    </h1>
    <a href="/genres/add">
        <button>Add genre</button>
    </a>
    <div>
        <% genres.forEach(genre => { %>
            <a>
                <div>
                    <p><%= genre.name %></p>
                </div>
            </a>
        <%})%>
    </div>
</body>
</html>