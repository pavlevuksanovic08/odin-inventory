<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/genre.css">
    <title>Document</title>
</head>
<body>
    <h1>
        Genres
    </h1>
    <a href="/genres/add">
        <button>Add genre</button>
    </a>
    <div>
        <% genres.forEach(genre => { %>
            <a>
                <div class="genreDiv">
                    <a href="/movies?genres=<%= genre.genreid %>">
                        <p><%= genre.name %></p>                       
                    </a>
                    <div class="btns">
                        <a href="genres/<%= genre.genreid %>/edit">
                            <img src="/images/edit.png">
                        </a>
                        <form method="post" action="/genres/<%= genre.genreid %>/delete" 
                            onsubmit="return confirm('If you delete this genre you are also going to delete all movies with this genre. Do you still want to delete it?')">
                            <button type="submit" style="background:none; border:none; padding:0;">
                                <img src="/images/bin.png" alt="delete">
                            </button>
                        </form>
                    </div>
                </div>
            </a>
        <%})%>
    </div>
</body>
</html>